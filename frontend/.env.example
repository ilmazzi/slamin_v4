# Slamin — frontend (Vite) — copiare in .env e personalizzare
# cp .env.example .env

# -----------------------------------------------------------------------------
# Chiamate API
# -----------------------------------------------------------------------------
# Svuotare o omettere = il browser usa path relativi (/api/...) e in dev
# Vite inoltra a Laravel tramite proxy (sotto).
#
# Con valore assoluto = chiamate dirette al backend (verifica CORS lato API).
# Esempio Herd: https://slamin.test
VITE_API_BASE_URL=

# Proxy dev (solo `npm run dev` in `frontend/`): inoltra /api e /storage al backend
# VITE_API_PROXY_TARGET: URL base del vhost Herd, senza path /api
VITE_API_PROXY_TARGET=http://slamin_v4.test
# VITE_API_PROXY_HOST: deve coincidere col ServerName del virtual host Laravel
VITE_API_PROXY_HOST=slamin_v4.test

# -----------------------------------------------------------------------------
# Widget feedback (opzionale)
# -----------------------------------------------------------------------------
# VITE_OPENPROJECT_FEEDBACK_ENABLED=true
# VITE_OPENPROJECT_FEEDBACK_AUTH_ONLY=true
# VITE_OPENPROJECT_FEEDBACK_ROUTE=/api/feedback
# VITE_OPENPROJECT_FEEDBACK_TEXT=Feedback

# -----------------------------------------------------------------------------
# Laravel Reverb (realtime chat)
# -----------------------------------------------------------------------------
# In locale: valori reali (Vite non espande ${REVERB_APP_KEY} da questo file).
# Su Forge: basta il .env Laravel (REVERB_* / VITE_REVERB_*); il build le legge da lì.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
